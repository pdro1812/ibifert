# Copie para .env (na mesma pasta dos docker-compose) e preencha.
# O .env NÃO vai para o git. Gere valores fortes, por exemplo:
#   senha do banco: openssl rand -base64 18 | tr '+/' '-_'
#   JWT_SECRET:     openssl rand -hex 32
# Na senha do banco use só letras, números e - _ . ~ (ela entra numa URL).
# Troca em produção: docs/trocar-segredos-producao.md

POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=ibifertydb
JWT_SECRET=
